# --- Core ---
PORT=3000

# Protects the tenant-management API (POST/GET/PATCH /admin/tenants/...).
# Generate a long random string; treat it like a password.
ADMIN_API_KEY=

# --- Firebase / Firestore ---
# No env vars needed here: on Cloud Run, the service's default credentials
# are used automatically. For local development, run:
#   gcloud auth application-default login
# so the Firebase Admin SDK can reach your project's Firestore.

# --- Website widget ---
# Nothing global — each tenant gets their own siteKey (see Tenant.website.siteKey),
# embedded in their widget's data-site-key attribute.

# --- Meta (Facebook + Instagram) ---
# One shared Meta app used across every tenant's Page/IG account.
# Shared verify token you choose yourself, used for the webhook handshake.
META_VERIFY_TOKEN=choose-a-random-string
META_APP_SECRET=xxxxx
META_GRAPH_API_VERSION=v21.0
# Needed for the dashboard's "Connect via Facebook" OAuth button (Facebook
# Login product on the Meta App). Leave blank if you'll only ever connect
# tenants by pasting Page IDs/tokens in manually.
META_APP_ID=
# Each tenant's own Page ID + Page Access Token are stored on their Tenant
# document (facebook.pageId / facebook.pageAccessToken), not here.

# --- WhatsApp Cloud API ---
# One shared WhatsApp app; each tenant brings their own phone number + token
# (stored on their Tenant document as whatsapp.phoneNumberId / whatsapp.accessToken).
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Gmail ---
# One shared Google OAuth client; each tenant authorizes their own inbox and
# gets their own token set stored on their Tenant document (gmail.tokens).
GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxx
GMAIL_REDIRECT_URI=http://localhost:3000/gmail/oauth2callback
GMAIL_LABEL_TO_WATCH=INBOX
# Only needed if you're triggering polls via POST /gmail/poll (e.g. Cloud
# Scheduler on Cloud Run) instead of the long-running `npm run gmail:poll`.
GMAIL_CRON_SECRET=
# Only used by the standalone `npm run gmail:poll` worker.
GMAIL_POLL_INTERVAL_MS=60000
