# --- Core ---
PORT=3000

# Choose which LLM powers the bot: "anthropic" (Claude) or "openai" (GPT).
# Only fill in the key/model for the provider you pick.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o-mini

BOT_NAME=Assistant
BOT_PERSONA=You are a friendly, concise support assistant for our company. Answer questions helpfully and escalate to a human when you are unsure.

# --- Website widget ---
WEBSITE_ALLOWED_ORIGINS=http://localhost:3000,https://example.com

# --- Meta (Facebook + Instagram) ---
# Shared verify token you choose yourself, used for the webhook handshake.
META_VERIFY_TOKEN=choose-a-random-string
# Page access token generated in Meta App dashboard for your Facebook Page
# (Instagram messaging also uses this once the Page is linked to the IG account).
META_PAGE_ACCESS_TOKEN=xxxxx
META_APP_SECRET=xxxxx
META_GRAPH_API_VERSION=v21.0

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_ACCESS_TOKEN=xxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxx
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Gmail ---
GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxx
GMAIL_REDIRECT_URI=http://localhost:3000/gmail/oauth2callback
# Comma separated addresses whose mail should never be auto-replied to (avoid loops)
GMAIL_IGNORE_SENDERS=
GMAIL_POLL_INTERVAL_MS=60000
GMAIL_LABEL_TO_WATCH=INBOX
